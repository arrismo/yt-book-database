{
  "manifest_version": 3,
  "name": "Reading Room Caption Finder",
  "version": "0.1.0",
  "description": "Find books mentioned in YouTube captions while you watch.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://*/*"],
  "action": {
    "default_title": "Reading Room",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "reading-room-caption-finder@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
